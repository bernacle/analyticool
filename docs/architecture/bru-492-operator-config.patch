+  # BRU-492 preparation: real local Supabase Auth + PostgreSQL evidence (verification/auth-metadata).
+  # The OPERATOR starts the disposable stack OUTSIDE the sandbox before preflight/run:
+  #   bash verification/auth-metadata/stack.sh prefetch && bash verification/auth-metadata/stack.sh start
+  # (Docker is host-level power and never runs inside a check). This check only reaches the stack's
+  # loopback ports and reads the state file granted by isolation.read_paths. A stopped stack fails
+  # the check; it never skips. Where the suite does not exist yet (the untouched base), the check
+  # verifies only that the operator stack answers on loopback.
+  - name: auth-metadata
+    timeout_minutes: 10
+    run: |
+      set -euo pipefail
+      export ANALYTICOOL_AUTH_STACK_STATE=/Users/brunosimplicio/.local/state/analyticool-bru492
+      STATE="$ANALYTICOOL_AUTH_STACK_STATE/stack.env"
+      [ -r "$STATE" ] || { echo "auth-metadata: operator stack not started (no $STATE)"; exit 1; }
+      if [ ! -f verification/auth-metadata/run-checks.sh ]; then
+        set -a; . "$STATE"; set +a
+        node -e 'fetch(process.env.ANALYTICOOL_AUTH_TEST_API_URL + "/auth/v1/health", { headers: { apikey: process.env.ANALYTICOOL_AUTH_TEST_PUBLISHABLE_KEY } }).then((r) => { if (!r.ok) process.exit(1); })'
+        echo "auth-metadata: no suite at verification/auth-metadata on this ref; loopback stack reachability verified only"
+        exit 0
+      fi
+      bash verification/auth-metadata/run-checks.sh
 
